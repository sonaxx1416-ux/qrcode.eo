# qrcode.eo — صنع QR Code بلغة eo
#
#   import qrcode
#   var q = qrcode.QR("https://eolang.com")
#   q.save "qr.png"      (أو .svg أو .txt)
#   q.show               (يرسمه في الطرفية)
#
# مكتوبة بـ eo بالكامل: Reed-Solomon، والأقنعة، وملف PNG، بدون أي تعديل في اللغة.
# تدعم من النسخة 1 لين 10 (لين 271 بايت تقريبًا بمستوى L).

const VERSION = "1.0.0"
const MAX_VERSION = 10

# ═════════════════════════════════════════════
#  QR
# ═════════════════════════════════════════════

struct QR {
    data
    # مستوى تصحيح الأخطاء: L (7%) M (15%) Q (25%) H (30%)
    level @string = "M"
    # حجم المربع الواحد في الصورة (بالبكسل)
    box @int = 10
    # الإطار الأبيض حول الكود (بالمربعات)، 4 هو المعيار
    border @int = 4
    fill @string = "#000000"
    back @string = "#ffffff"
    # 0 = يختار أصغر نسخة تكفي النص
    version @int = 0
    # -1 = يختار أفضل قناع
    mask @int = -1
    size @int = 0
    matrix @list
    error @string
    built @string
    # النسخة والقناع اللي انختاروا فعلًا
    used_version @int = 0
    used_mask @int = -1
}

# يبني الكود (تنادى لحالها من save و show)، ويرجع true لو نجح
func QR.make {
    var key = h"${self.data}|${self.level}|${self.version}|${self.mask}"
    if self.built == key and self.error == "" {
        return true
    }
    self.error = ""
    var lv = upper(trim(self.level))
    if not has(LEVEL_BITS, lv) {
        return self._fail(h"unknown level '${self.level}' (use L, M, Q or H)")
    }
    var payload = bytes(string(self.data))
    var v = self.version
    if v == 0 {
        v = fit_version(len(payload), lv)
        if v == 0 {
            var hint = ""
            if lv != "L" {
                hint = h" (level L fits up to ${capacity(MAX_VERSION, "L")})"
            }
            return self._fail(h"the text is too long: ${len(payload)} bytes, the most at level ${lv} is ${capacity(MAX_VERSION, lv)}${hint}")
        }
    } elif v < 1 or v > MAX_VERSION {
        return self._fail(h"version must be 1 to ${MAX_VERSION}")
    } elif len(payload) > capacity(v, lv) {
        return self._fail(h"the text needs a bigger version than ${v}")
    }
    var codewords = add_ecc(encode_data(payload, v, lv), v, lv)
    var g = Grid(v)
    g.function_patterns()
    g.place(codewords)
    var m = self.mask
    if m < 0 or m > 7 {
        m = g.best_mask(lv)
    }
    g.apply_mask(m)
    g.format_bits(lv, m)
    self.size = g.size
    self.matrix = g.mods
    self.built = key
    self.used_version = v
    self.used_mask = m
    return true
}

func QR._fail why @string {
    self.error = why
    print "[qrcode] " + why
    return false
}

# q.save "qr.png"   أو "qr.svg"   أو "qr.txt"
func QR.save path @string {
    if not self.make() {
        return false
    }
    var low = lower(path)
    if endswith(low, ".svg") {
        write_file path, self.svg()
    } elif endswith(low, ".txt") {
        write_file path, self.text()
    } else {
        write_file path, self.png()
    }
    return true
}

# يرسمه في الطرفية (الجوال يقدر يقراه من الشاشة)
func QR.show {
    if not self.make() {
        return
    }
    print self.terminal()
}

# نفس show بس يرجعه كنص بدل ما يطبعه: var t = q.retu
func QR.retu {
    if not self.make() {
        return ""
    }
    return self.terminal()
}

# الكود كنص بـ █ (مربعين لكل وحدة)
func QR.text {
    if not self.make() {
        return ""
    }
    var lines = []
    var n = self.size + self.border * 2
    for y in range(n) {
        var row = ""
        for x in range(n) {
            if self.dark(x - self.border, y - self.border) {
                row = row + "██"
            } else {
                row = row + "  "
            }
        }
        append lines, row
    }
    return join(lines, "\n")
}

# true لو المربع أسود (برا الكود = أبيض)
func QR.dark x @int, y @int {
    if x < 0 or y < 0 or x >= self.size or y >= self.size {
        return false
    }
    return self.matrix[y][x] == 1
}

# ═════════════════════════════════════════════
#  العرض في الطرفية: كل سطر نص = سطرين من الكود
# ═════════════════════════════════════════════

func QR.terminal {
    if not self.make() {
        return ""
    }
    var f = rgb(self.fill)
    var k = rgb(self.back)
    var color = h"\u001b[38;2;${f[0]};${f[1]};${f[2]};48;2;${k[0]};${k[1]};${k[2]}m"
    var b = self.border
    var n = self.size + b * 2
    var lines = []
    var y = 0
    while y < n {
        var row = color
        for x in range(n) {
            var top = self.dark(x - b, y - b)
            var bottom = self.dark(x - b, y + 1 - b)
            if top and bottom {
                row = row + "█"
            } elif top {
                row = row + "▀"
            } elif bottom {
                row = row + "▄"
            } else {
                row = row + " "
            }
        }
        append lines, row + "\u001b[0m"
        y += 2
    }
    return join(lines, "\n")
}

# ═════════════════════════════════════════════
#  SVG
# ═════════════════════════════════════════════

func QR.svg {
    var b = self.border
    var n = self.size + b * 2
    var px = n * self.box
    var path = []
    for y in range(self.size) {
        for x in range(self.size) {
            if self.matrix[y][x] == 1 {
                append path, h"M${x + b},${y + b}h1v1h-1z"
            }
        }
    }
    var out = h"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${px}\" height=\"${px}\" viewBox=\"0 0 ${n} ${n}\" shape-rendering=\"crispEdges\">\n"
    out = out + h"<rect width=\"${n}\" height=\"${n}\" fill=\"${self.back}\"/>\n"
    out = out + h"<path fill=\"${self.fill}\" d=\"${join(path, "")}\"/>\n</svg>\n"
    return out
}

# ═════════════════════════════════════════════
#  PNG (صورة بلونين، بت لكل بكسل)
# ═════════════════════════════════════════════

func QR.png {
    var b = self.border
    var n = self.size + b * 2
    var px = n * self.box
    var row_bytes = (px + 7) / 8
    var raw = []
    for my in range(n) {
        # سطر بكسلات لصف واحد من المربعات، ويتكرر box مرة
        var line = [0]
        var acc = 0
        var bits = 0
        for mx in range(n) {
            var bit = 0
            if self.dark(mx - b, my - b) {
                bit = 1
            }
            for k in range(self.box) {
                acc = acc * 2 + bit
                bits += 1
                if bits == 8 {
                    append line, acc
                    acc = 0
                    bits = 0
                }
            }
        }
        if bits > 0 {
            for k in range(8 - bits) {
                acc = acc * 2
            }
            append line, acc
        }
        for k in range(self.box) {
            for v in line {
                append raw, v
            }
        }
    }
    var out = [137, 80, 78, 71, 13, 10, 26, 10]
    var ihdr = be32(px) + be32(px) + [1, 3, 0, 0, 0]
    png_chunk(out, "IHDR", ihdr)
    # اللون 0 = الخلفية، اللون 1 = الكود
    png_chunk(out, "PLTE", rgb(self.back) + rgb(self.fill))
    png_chunk(out, "IDAT", zlib_stored(raw))
    png_chunk(out, "IEND", [])
    return from_bytes(out)
}

func png_chunk out @list, kind @string, data @list {
    for v in be32(len(data)) {
        append out, v
    }
    var body = bytes(kind)
    for v in data {
        append body, v
    }
    for v in body {
        append out, v
    }
    for v in be32(crc32(body)) {
        append out, v
    }
}

func be32 n @int {
    return [bit_and(shr(n, 24), 255), bit_and(shr(n, 16), 255), bit_and(shr(n, 8), 255), bit_and(n, 255)]
}

# أسماء ألوان: q.fill = "white"
const COLORS = {"black": "#000000", "white": "#ffffff", "red": "#ff0000", "green": "#008000", "blue": "#0000ff", "yellow": "#ffff00", "orange": "#ffa500", "purple": "#800080", "pink": "#ffc0cb", "gray": "#808080", "grey": "#808080", "cyan": "#00ffff", "magenta": "#ff00ff", "brown": "#8b4513", "navy": "#000080", "gold": "#ffd700"}

# "#ff8800" أو "#f80" أو "orange" → [255, 136, 0]
func rgb hex @string {
    var name = lower(trim(hex))
    if has(COLORS, name) {
        return rgb(COLORS[name])
    }
    var h = replace(name, "#", "")
    if len(h) == 3 {
        h = slice(h, 0, 1) * 2 + slice(h, 1, 2) * 2 + slice(h, 2, 3) * 2
    }
    if len(h) != 6 {
        return [0, 0, 0]
    }
    return [int(slice(h, 0, 2), 16), int(slice(h, 2, 4), 16), int(slice(h, 4, 6), 16)]
}

var CRC_TABLE = []
for n in range(256) {
    var c = n
    for k in range(8) {
        if bit_and(c, 1) == 1 {
            c = xor(3988292384, shr(c, 1))
        } else {
            c = shr(c, 1)
        }
    }
    append CRC_TABLE, c
}

func crc32 data @list {
    var c = 4294967295
    for v in data {
        c = xor(CRC_TABLE[bit_and(xor(c, v), 255)], shr(c, 8))
    }
    return xor(c, 4294967295)
}

# zlib بدون ضغط (stored blocks): أبسط شي يقراه أي برنامج صور
func zlib_stored data @list {
    var out = [120, 1]
    var n = len(data)
    var pos = 0
    while true {
        var size = n - pos
        if size > 65535 {
            size = 65535
        }
        var last = 0
        if pos + size >= n {
            last = 1
        }
        append out, last
        append out, bit_and(size, 255)
        append out, shr(size, 8)
        var nlen = xor(size, 65535)
        append out, bit_and(nlen, 255)
        append out, shr(nlen, 8)
        for i in range(size) {
            append out, data[pos + i]
        }
        pos += size
        if last == 1 {
            break
        }
    }
    var a = 1
    var b2 = 0
    for v in data {
        a = (a + v) % 65521
        b2 = (b2 + a) % 65521
    }
    for v in be32(b2 * 65536 + a) {
        append out, v
    }
    return out
}

# ═════════════════════════════════════════════
#  الجداول (من معيار QR، النسخ 1 لين 10)
# ═════════════════════════════════════════════

# لكل نسخة ومستوى: [ECC لكل بلوك، بلوكات المجموعة 1، بيانات كل بلوك، بلوكات المجموعة 2، بيانات كل بلوك]
const BLOCKS = {
    "L": [[], [7, 1, 19, 0, 0], [10, 1, 34, 0, 0], [15, 1, 55, 0, 0], [20, 1, 80, 0, 0], [26, 1, 108, 0, 0], [18, 2, 68, 0, 0], [20, 2, 78, 0, 0], [24, 2, 97, 0, 0], [30, 2, 116, 0, 0], [18, 2, 68, 2, 69]],
    "M": [[], [10, 1, 16, 0, 0], [16, 1, 28, 0, 0], [26, 1, 44, 0, 0], [18, 2, 32, 0, 0], [24, 2, 43, 0, 0], [16, 4, 27, 0, 0], [18, 4, 31, 0, 0], [22, 2, 38, 2, 39], [22, 3, 36, 2, 37], [26, 4, 43, 1, 44]],
    "Q": [[], [13, 1, 13, 0, 0], [22, 1, 22, 0, 0], [18, 2, 17, 0, 0], [26, 2, 24, 0, 0], [18, 2, 15, 2, 16], [24, 4, 19, 0, 0], [18, 2, 14, 4, 15], [22, 4, 18, 2, 19], [20, 4, 16, 4, 17], [24, 6, 19, 2, 20]],
    "H": [[], [17, 1, 9, 0, 0], [28, 1, 16, 0, 0], [22, 2, 13, 0, 0], [16, 4, 9, 0, 0], [22, 2, 11, 2, 12], [28, 4, 15, 0, 0], [26, 4, 13, 1, 14], [26, 4, 14, 2, 15], [24, 4, 12, 4, 13], [28, 6, 15, 2, 16]]
}

const ALIGN = [[], [], [6, 18], [6, 22], [6, 26], [6, 30], [6, 34], [6, 22, 38], [6, 24, 42], [6, 26, 46], [6, 28, 50]]

const LEVEL_BITS = {"L": 1, "M": 0, "Q": 3, "H": 2}

func data_codewords v @int, lv @string {
    var t = BLOCKS[lv][v]
    return t[1] * t[2] + t[3] * t[4]
}

func count_bits v @int {
    if v < 10 {
        return 8
    }
    return 16
}

# كم بايت يدخل في نسخة ومستوى (وضع البايتات)
func capacity v @int, lv @string {
    return (data_codewords(v, lv) * 8 - 4 - count_bits(v)) / 8
}

func fit_version n @int, lv @string {
    for v in range(1, MAX_VERSION + 1) {
        if n <= capacity(v, lv) {
            return v
        }
    }
    return 0
}

# ═════════════════════════════════════════════
#  البيانات
# ═════════════════════════════════════════════

func push_bits bits @list, value @int, count @int {
    var i = count - 1
    while i >= 0 {
        append bits, bit_and(shr(value, i), 1)
        i -= 1
    }
}

func encode_data payload @list, v @int, lv @string {
    var bits = []
    push_bits(bits, 4, 4)
    push_bits(bits, len(payload), count_bits(v))
    for b in payload {
        push_bits(bits, b, 8)
    }
    var cap = data_codewords(v, lv) * 8
    var term = cap - len(bits)
    if term > 4 {
        term = 4
    }
    for i in range(term) {
        append bits, 0
    }
    while len(bits) % 8 != 0 {
        append bits, 0
    }
    var words = []
    var i = 0
    while i < len(bits) {
        var w = 0
        for k in range(8) {
            w = w * 2 + bits[i + k]
        }
        append words, w
        i += 8
    }
    var pad = 236
    while len(words) < data_codewords(v, lv) {
        append words, pad
        if pad == 236 {
            pad = 17
        } else {
            pad = 236
        }
    }
    return words
}

# ═════════════════════════════════════════════
#  Reed-Solomon (GF(256))
# ═════════════════════════════════════════════

var GF_EXP = []
var GF_LOG = []
for i in range(256) {
    append GF_LOG, 0
}
var gx = 1
for i in range(255) {
    append GF_EXP, gx
    GF_LOG[gx] = i
    gx = gx * 2
    if gx >= 256 {
        gx = xor(gx, 285)
    }
}

func gf_mul a @int, b @int {
    if a == 0 or b == 0 {
        return 0
    }
    return GF_EXP[(GF_LOG[a] + GF_LOG[b]) % 255]
}

func rs_divisor degree @int {
    var result = []
    for i in range(degree - 1) {
        append result, 0
    }
    append result, 1
    var root = 1
    for i in range(degree) {
        for j in range(degree) {
            result[j] = gf_mul(result[j], root)
            if j + 1 < degree {
                result[j] = xor(result[j], result[j + 1])
            }
        }
        root = gf_mul(root, 2)
    }
    return result
}

func rs_remainder data @list, divisor @list {
    var n = len(divisor)
    var result = []
    for i in range(n) {
        append result, 0
    }
    for b in data {
        var factor = xor(b, result[0])
        result = slice(result, 1)
        append result, 0
        if factor != 0 {
            for i in range(n) {
                result[i] = xor(result[i], gf_mul(divisor[i], factor))
            }
        }
    }
    return result
}

# يقسم البيانات بلوكات، يضيف ECC، ويخلطهم بالترتيب الصح
func add_ecc words @list, v @int, lv @string {
    var t = BLOCKS[lv][v]
    var div = rs_divisor(t[0])
    var datas = []
    var eccs = []
    var pos = 0
    for g in [[t[1], t[2]], [t[3], t[4]]] {
        for k in range(g[0]) {
            var block = slice(words, pos, pos + g[1])
            pos += g[1]
            append datas, block
            append eccs, rs_remainder(block, div)
        }
    }
    var out = []
    var longest = t[2]
    if t[4] > longest {
        longest = t[4]
    }
    for i in range(longest) {
        for block in datas {
            if i < len(block) {
                append out, block[i]
            }
        }
    }
    for i in range(t[0]) {
        for e in eccs {
            append out, e[i]
        }
    }
    return out
}

# ═════════════════════════════════════════════
#  الشبكة
# ═════════════════════════════════════════════

struct Grid {
    version @int
    size @int
    mods @list
    fixed @list
}

func Grid.init {
    self.size = self.version * 4 + 17
    self.mods = []
    self.fixed = []
    for y in range(self.size) {
        var a = []
        var b = []
        for x in range(self.size) {
            append a, 0
            append b, 0
        }
        append self.mods, a
        append self.fixed, b
    }
}

func Grid.set x @int, y @int, dark @bool {
    if dark {
        self.mods[y][x] = 1
    } else {
        self.mods[y][x] = 0
    }
    self.fixed[y][x] = 1
}

func Grid.function_patterns {
    self.init()
    var s = self.size
    for i in range(s) {
        self.set(6, i, i % 2 == 0)
        self.set(i, 6, i % 2 == 0)
    }
    self.finder(3, 3)
    self.finder(s - 4, 3)
    self.finder(3, s - 4)
    var pos = ALIGN[self.version]
    var n = len(pos)
    for i in range(n) {
        for j in range(n) {
            if not ((i == 0 and j == 0) or (i == 0 and j == n - 1) or (i == n - 1 and j == 0)) {
                self.alignment(pos[i], pos[j])
            }
        }
    }
    # مكان معلومات الصيغة (تنكتب بعدين)
    self.format_bits("M", 0)
    self.version_bits()
}

func Grid.finder cx @int, cy @int {
    for dy in range(-4, 5) {
        for dx in range(-4, 5) {
            var x = cx + dx
            var y = cy + dy
            if x >= 0 and y >= 0 and x < self.size and y < self.size {
                var d = max(abs(dx), abs(dy))
                self.set(x, y, d != 2 and d != 4)
            }
        }
    }
}

func Grid.alignment cx @int, cy @int {
    for dy in range(-2, 3) {
        for dx in range(-2, 3) {
            self.set(cx + dx, cy + dy, max(abs(dx), abs(dy)) != 1)
        }
    }
}

func bit_at value @int, i @int {
    return bit_and(shr(value, i), 1) == 1
}

func Grid.format_bits lv @string, mask @int {
    var data = LEVEL_BITS[lv] * 8 + mask
    var rem = data
    for i in range(10) {
        rem = xor(shl(rem, 1), shr(rem, 9) * 1335)
    }
    var bits = xor(shl(data, 10) + rem, 21522)
    var s = self.size
    for i in range(6) {
        self.set(8, i, bit_at(bits, i))
    }
    self.set(8, 7, bit_at(bits, 6))
    self.set(8, 8, bit_at(bits, 7))
    self.set(7, 8, bit_at(bits, 8))
    for i in range(9, 15) {
        self.set(14 - i, 8, bit_at(bits, i))
    }
    for i in range(8) {
        self.set(s - 1 - i, 8, bit_at(bits, i))
    }
    for i in range(8, 15) {
        self.set(8, s - 15 + i, bit_at(bits, i))
    }
    self.set(8, s - 8, true)
}

func Grid.version_bits {
    if self.version < 7 {
        return
    }
    var rem = self.version
    for i in range(12) {
        rem = xor(shl(rem, 1), shr(rem, 11) * 7973)
    }
    var bits = shl(self.version, 12) + rem
    for i in range(18) {
        var a = self.size - 11 + i % 3
        var b = i / 3
        var dark = bit_at(bits, i)
        self.set(a, b, dark)
        self.set(b, a, dark)
    }
}

# يحط البيانات بشكل زجزاج من تحت يمين
func Grid.place codewords @list {
    var s = self.size
    var total = len(codewords) * 8
    var i = 0
    var right = s - 1
    while right >= 1 {
        if right == 6 {
            right = 5
        }
        var upward = bit_and(right + 1, 2) == 0
        for vert in range(s) {
            for j in range(2) {
                var x = right - j
                var y = vert
                if upward {
                    y = s - 1 - vert
                }
                if self.fixed[y][x] == 0 and i < total {
                    if bit_at(codewords[shr(i, 3)], 7 - bit_and(i, 7)) {
                        self.mods[y][x] = 1
                    }
                    i += 1
                }
            }
        }
        right -= 2
    }
}

func mask_hit m @int, x @int, y @int {
    if m == 0 {
        return (x + y) % 2 == 0
    } elif m == 1 {
        return y % 2 == 0
    } elif m == 2 {
        return x % 3 == 0
    } elif m == 3 {
        return (x + y) % 3 == 0
    } elif m == 4 {
        return (x / 3 + y / 2) % 2 == 0
    } elif m == 5 {
        return (x * y) % 2 + (x * y) % 3 == 0
    } elif m == 6 {
        return ((x * y) % 2 + (x * y) % 3) % 2 == 0
    }
    return ((x + y) % 2 + (x * y) % 3) % 2 == 0
}

func Grid.apply_mask m @int {
    for y in range(self.size) {
        for x in range(self.size) {
            if self.fixed[y][x] == 0 and mask_hit(m, x, y) {
                self.mods[y][x] = 1 - self.mods[y][x]
            }
        }
    }
}

# يجرب الأقنعة الثمانية ويختار الأقل "عقوبة" (أسهل قراءة)
func Grid.best_mask lv @string {
    var best = 0
    var best_score = -1
    for m in range(8) {
        self.apply_mask(m)
        self.format_bits(lv, m)
        var score = self.penalty()
        if best_score < 0 or score < best_score {
            best = m
            best_score = score
        }
        self.apply_mask(m)
    }
    return best
}

func Grid.penalty {
    var s = self.size
    var score = 0
    var dark = 0
    var rows = []
    var cols = []
    for y in range(s) {
        append rows, join(map(self.mods[y], lambda v { string(v) }), "")
    }
    for x in range(s) {
        var c = ""
        for y in range(s) {
            c = c + string(self.mods[y][x])
        }
        append cols, c
    }
    for line in rows + cols {
        # 1: خمسة أو أكثر من نفس اللون ورا بعض
        var run = 1
        var chars = split(line, "")
        for i in range(1, s) {
            if chars[i] == chars[i - 1] {
                run += 1
            } else {
                if run >= 5 {
                    score += run - 2
                }
                run = 1
            }
        }
        if run >= 5 {
            score += run - 2
        }
        # 3: شكل يشبه مربعات الزوايا
        score += (len(split(line, "10111010000")) - 1) * 40
        score += (len(split(line, "00001011101")) - 1) * 40
    }
    # 2: مربعات 2×2 من نفس اللون
    for y in range(s - 1) {
        var r1 = self.mods[y]
        var r2 = self.mods[y + 1]
        for x in range(s - 1) {
            var c = r1[x]
            if r1[x + 1] == c and r2[x] == c and r2[x + 1] == c {
                score += 3
            }
        }
    }
    # 4: نسبة الأسود بعيدة عن 50%
    for y in range(s) {
        dark += sum(self.mods[y])
    }
    var total = s * s
    var k = (abs(dark * 20 - total * 10) + total - 1) / total - 1
    if k > 0 {
        score += k * 10
    }
    return score
}

